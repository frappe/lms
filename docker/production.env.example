# Copy to docker/.env on the server. Never commit real secrets.
MARIADB_ROOT_PASSWORD=replace-with-a-long-random-password
LMS_ADMIN_PASSWORD=replace-with-a-long-random-password
LMS_BIND_ADDRESS=127.0.0.1

# SMTP: leave blank until a provider is selected.
MAIL_SERVER=
MAIL_PORT=587
MAIL_LOGIN=
MAIL_PASSWORD=
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_DEFAULT_SENDER=

# Off-site backups. Example: s3:lms-production/backups
BACKUP_REMOTE=
BACKUP_RETENTION_DAYS=7

# Optional heartbeat endpoint from UptimeRobot, Better Stack, Healthchecks.io, etc.
HEALTHCHECK_PING_URL=

# Payment provider contract. Add only test keys first.
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_TEST_MODE=1
