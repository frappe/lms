# Copy to scripts/deploy/deploy.env and fill in. This file stays on your laptop and is
# git-ignored. Secrets (database and admin passwords) are never written here.

# SSH target for the production server (must already accept your key).
DEPLOY_HOST=user@your-server.example.com

# Where the stack lives on the server.
DEPLOY_DIR=/opt/lms

# The site's name. Use the public domain, for example lms.example.com.
SITE_NAME=lms.example.com

# Git ref to build. Default main.
REF=main

# Local image name. The tag is the commit SHA.
IMAGE_REPO=lms-prod

# Target platform of the server.
PLATFORM=linux/amd64

# Docker network for the image build. host avoids flaky DNS in Docker's build network.
BUILD_NETWORK=host

# Python package index for the build. Leave blank for pypi.org. A closer mirror makes
# the first build much faster when pypi.org is slow from your network.
UV_DEFAULT_INDEX=
