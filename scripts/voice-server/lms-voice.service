# /etc/systemd/system/lms-voice.service
[Unit]
Description=Learning voice server (Kokoro speaks, Whisper listens)
After=network-online.target
Wants=network-online.target

[Service]
User=lmsvoice
WorkingDirectory=/home/lmsvoice
EnvironmentFile=/home/lmsvoice/voice.env
ExecStart=/home/lmsvoice/.local/bin/uv run /home/lmsvoice/kokoro_server.py
Restart=always
RestartSec=5
# Torch and the two models fit in about 2 GB; stop a runaway before it takes the box.
MemoryMax=3G

[Install]
WantedBy=multi-user.target
