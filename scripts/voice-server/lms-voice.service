# /etc/systemd/system/lms-voice.service
[Unit]
Description=Learning voice server (Kokoro speaks, Whisper listens)
After=network-online.target
Wants=network-online.target

[Service]
User=lmsvoice
WorkingDirectory=/home/lmsvoice
EnvironmentFile=/home/lmsvoice/voice.env
ExecStart=/home/lmsvoice/.local/bin/uv run /home/lmsvoice/kokoro_server.py
Restart=always
RestartSec=5
# Torch and the two models grow to about 4 GB in use; a 4 GB cap left the server stuck
# swapping with every request hanging. The cap only stops a true runaway.
MemoryMax=10G

[Install]
WantedBy=multi-user.target
